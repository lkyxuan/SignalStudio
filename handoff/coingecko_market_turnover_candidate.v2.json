          "type": "string",
          "source": "input.coin_id"
        },
        {
          "name": "last_updated",
          "type": "string",
          "source": "input.last_updated"
        },
        {
          "name": "total_volume_usd_24h",
          "type": "number",
          "source": "input.total_volume_usd_24h"
        },
        {
          "name": "market_cap_usd",
          "type": "number",
          "source": "input.market_cap_usd"
        },
        {
          "name": "turnover_ratio_24h",
          "type": "number",
          "source": "calculation.turnover_ratio_24h"
        },
        {
          "name": "source_observation_id",
          "type": "string",
          "source": "runtime.source_observation_id"
        },
        {
          "name": "source_run_id",
          "type": "string",
          "source": "runtime.source_run_id"
        }
      ],
      "coverage": {
        "required": true,
        "states": [
          "complete",
          "partial_coverage",
          "failed"
        ],
        "no_match_interpretation": "no_candidate_in_observed_coverage_only"
      }
    },
    "validation": {
      "status": "not_run",
      "plan_zh": "取得实际爬虫运行记录后，核对分页覆盖、字段映射和计算值；抽样人工检查候选与漏掉的币种，再用历史样本调整阈值。",
      "required_evidence": [
        "successful_source_run",
        "emitted_record_sample",
        "field_mapping",
        "calculation_check",
        "historical_review"
      ],
      "known_false_positives_zh": [
        "低流动性市场的异常成交",
        "市值数据滞后",
        "刷量或重复统计"
      ]
    },
    "implementation_report": {
      "required": true,
      "fields": [
