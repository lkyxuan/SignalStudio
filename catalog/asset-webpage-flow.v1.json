        },
        {
          "name": "search_policy",
          "type": "string",
          "label_zh": "当前默认实时补搜；未来可按覆盖判断"
        },
        {
          "name": "page_ref",
          "type": "TEXT",
          "label_zh": "当前网页位置；无网页可空"
        }
      ],
      "output_fields": [
