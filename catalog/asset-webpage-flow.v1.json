  "cards": [
    {
      "key": "candidates",
      "name": "候选代币筛选",
      "kind": "process",
      "description_zh": "合并升温、最热、新发现UUID三榜有效结果；仅已确认代币进入内容维护。",
      "algorithm_zh": "各榜先校验完整有效批次并过滤已确认代币，再按本榜排序取前20，按asset_id合并去重；新发现按created_at倒序，其他两榜按score降序。保留本榜引用，缺榜独立跳过，不回退旧total_heat。",
      "trigger_zh": "三榜完整结果成功提交、启动时及每60秒补查；各榜前20个已确认代币，合并最多60个。",
      "fields": [
        {
          "name": "asset_id",
          "type": "string",
          "label_zh": "稳定内部资产ID"
        },
        {
          "name": "calculated_at",
          "type": "string",
          "label_zh": "榜单计算时间"
        },
        {
          "name": "score",
          "type": "number",
          "label_zh": "未舍入榜单分数"
        },
        {
          "name": "algorithm_version",
          "type": "string",
          "label_zh": "榜单算法版本"
        },
        {
          "name": "asset_kind",
          "type": "string",
          "label_zh": "只将coin交代币内容链"
        },
        {
          "name": "created_at",
          "type": "UTC timestamp",
          "label_zh": "首次建档时间；新榜排序依据"
        }
      ],
      "output_fields": [
        "asset_id"
      ]
    },
    {
      "key": "decision",
      "name": "刷新判断",
      "kind": "decision",
      "description_zh": "接收候选 UUID，查询 #1039 当前网页记录，判断首次制作或到期更新；一天/三天周期待定。",
      "algorithm_zh": "按候选 asset_id 完整查询当前网页记录。无记录为首次制作；查询失败或不完整则待核对。有网页时，以网页最后成功更新时间判断年龄；未知、无效或未来时间不可猜测。有有效时间且达到已配置整页周期才更新，未到期跳过。当前周期未配置，不对已有网页作过期结论。只有首次制作或到期更新进入资料准备。",
      "trigger_zh": "三榜完整结果成功提交、启动时及每60秒补查；各榜前20个已确认代币，合并最多60个。",
      "fields": [
        {
          "name": "asset_id",
          "type": "string",
          "label_zh": "候选资产 UUID"
        },
        {
          "name": "page_ref",
          "type": "TEXT",
          "label_zh": "当前网页位置；无网页可空"
        },
        {
          "name": "page_updated_at",
          "type": "TEXT",
          "label_zh": "#1039.updated_at，网页最后成功更新时间"
        },
        {
          "name": "action",
          "type": "string",
          "label_zh": "首次制作 / 更新 / 跳过 / 待核对"
        },
        {
          "name": "reason",
          "type": "string",
          "label_zh": "本次判定原因"
        },
        {
          "name": "age_minutes",
          "type": "number | null",
          "label_zh": "网页自上次成功更新经过分钟；未知为空"
        }
      ],
      "output_fields": [
        "asset_id",
        "action",
        "reason",
        "age_minutes",
        "page_ref"
      ]
    },
    {
      "key": "read",
      "name": "读取已有资料",
      "kind": "process",
      "description_zh": "按候选资产读取已收集的资料与现有网页位置，整理可用素材和缺口。",
      "algorithm_zh": "接收刷新判断交付的资产 UUID 与当前网页位置，按真实来源读取已有业务资料和搜索缓存，输出带来源的材料及缺口；不生成网页，不假装已接通数据源。",
      "trigger_zh": "收到当前资产的上一步有效结果后处理；打开卡片不执行。",
      "fields": [
        {
