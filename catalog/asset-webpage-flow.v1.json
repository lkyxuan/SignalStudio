        },
        {
          "name": "query_key",
          "type": "string",
          "label_zh": "稳定对象、类型、查询条件与工作流版本组成的需求键"
        },
        {
          "name": "query_json",
          "type": "JSON",
          "label_zh": "搜索条件及时间范围"
        },
        {
          "name": "results_json",
          "type": "JSON array",
          "label_zh": "本次成功搜索的可追溯结果"
        },
        {
          "name": "search_status",
