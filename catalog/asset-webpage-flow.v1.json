        "gaps_json",
        "search_policy",
        "page_ref"
      ]
    },
    {
      "key": "gap",
      "name": "判断资料缺口",
      "kind": "decision",
      "description_zh": "判断资料是否够用，决定补搜、继续组装或阻塞。",
      "algorithm_zh": "按材料范围与新鲜度判断缺口；当前沿用需要本次实时补搜的策略。资料不足或证据不可用时阻塞；将选择交给补搜或组装，不读取已删除的内容状态表。",
      "trigger_zh": "收到当前资产的上一步有效结果后处理；打开卡片不执行。",
