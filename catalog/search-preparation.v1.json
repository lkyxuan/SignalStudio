    {
      "key": "read",
      "name": "读取已有资料",
      "kind": "process",
      "description_zh": "读取系统已有业务资料与之前搜索保存的资料，输出可用资料和缺口；不发起搜索。",
      "algorithm_zh": "先复查首次/到期资格、身份、绑定及重试状态并原子认领内容任务，再按asset_id与资料需求读取已绑定来源。来源绑定为空不等于线上没有数据；过期资料不冒充实时证据。当前始终带实时搜索需求，已有资料仍用于后续生成。",
      "trigger_zh": "仅#3029首次/到期分支进入；任务认领设施未接通。",
      "fields": [
        {
          "name": "asset_id",
          "data_type": "string",
          "label_zh": "稳定内部资产ID",
          "meaning_en": "asset id",
          "required": true
        },
        {
