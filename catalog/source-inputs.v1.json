    "kaito.mcp.kaito_advanced_search": {
      "input_coverage": "public_proxy_snapshot",
      "input_note_zh": "来自 MetaSearch-IO 仓库 2026-04-01 的旧版工具实现；当前在线 MCP 参数尚未核对。",
      "inputs": [
        {
          "name": "tokens",
          "label_zh": "Kaito 对象代号列表",
          "required": false,
          "description_en": "Comma-separated resolved token values from kaito_tokens for entity disambiguation or entity-scoped filtering (e.g. BTC,ETH,HYPERLIQUID)"
        },
        {
          "name": "keyword",
          "label_zh": "关键词",
          "required": false,
          "description_en": "Legacy-compatible primary text query. Use the same style as query: 2-6 high-signal words or a short phrase cluster."
        },
        {
          "name": "query",
          "label_zh": "搜索词",
          "required": false,
          "description_en": "Primary text query. Can be 1-6 high-signal words (e.g. 'validator hack', 'etf inflow'). Omit entirely when tokens alone is sufficient. Avoid filler words and time expressions."
        },
        {
          "name": "usernames",
          "label_zh": "X 用户名列表",
          "required": false,
          "description_en": "Comma-separated Twitter usernames (Twitter source only)"
