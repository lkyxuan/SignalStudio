    "kaito.mcp.kaito_advanced_search": {
      "input_coverage": "live_mcp_input_schema",
      "input_note_zh": "来自 2026-09-28 Kaito 在线 MCP tools/list 的 inputSchema；必填按 schema 的 required 标注。",
      "inputs": [
        {
          "name": "rerank",
          "label_zh": "是否重排序",
          "required": false,
          "description_en": "Set false to keep the original search order for this MCP call."
        },
        {
          "name": "rerank_query",
          "label_zh": "重排序研究问题",
          "required": false,
          "description_en": "Optional full research question for server-side relevance reranking. Requires explicit UTC dates, relevance sort, from=0, size<=20. No provider key is accepted from callers."
        },
        {
          "name": "tokens",
          "label_zh": "Kaito 对象代号列表",
          "required": false,
          "description_en": "Comma-separated resolved token values from kaito_entities for entity disambiguation or entity-scoped filtering (e.g. BTC,ETH,HYPERLIQUID)"
        },
        {
          "name": "keyword",
          "label_zh": "关键词",
          "required": false,
          "description_en": "Original-compatible primary text query. Use the same style as query: 2-6 high-signal words or a short phrase cluster."
        },
        {
          "name": "query",
          "label_zh": "搜索词",
          "required": false,
          "description_en": "Primary text query. Can be 1-6 high-signal words (e.g. 'validator hack', 'etf inflow'). Omit entirely when tokens alone is sufficient. Avoid filler words and time expressions."
        },
        {
          "name": "usernames",
          "label_zh": "X 用户名列表",
          "required": false,
          "description_en": "Comma-separated Twitter usernames (Twitter source only)"
        },
        {
          "name": "sources",
          "label_zh": "内容来源",
          "required": false,
          "description_en": "Comma-separated: Twitter, News (default: Twitter,News)"
        },
        {
          "name": "min_created_at",
          "label_zh": "最早发布时间",
          "required": false,
          "description_en": "Min creation date ISO 8601 (default: 90 days ago)"
        },
        {
          "name": "max_created_at",
          "label_zh": "最晚发布时间",
          "required": false,
          "description_en": "Max creation date ISO 8601"
        },
        {
          "name": "from",
          "label_zh": "分页起点",
          "required": false,
          "description_en": "Pagination offset 0-500 (default: 0)"
        },
        {
          "name": "size",
          "label_zh": "每页条数",
          "required": false,
          "description_en": "Use 1-20 for reranking (default: 20). Larger requests preserve original search behavior."
        },
        {
          "name": "languages",
          "label_zh": "语言",
          "required": false,
          "description_en": "Comma-separated: en, zh, ko, others (default: en)"
        },
        {
          "name": "sort_by",
          "label_zh": "排序字段",
          "required": false,
          "description_en": "Sort field (default: relevance). NOTE: [smart_engagement, engagement, sentiment, bookmark, views, author] are only supported when sources=Twitter (not compatible with News)",
          "accepted_values": "relevance, created_at, engagement, smart_engagement, author, length, bookmark, sentiment, views"
        },
        {
          "name": "sort_order",
          "label_zh": "排序方向",
          "required": false,
          "description_en": "Sort order (default: desc). asc is mainly useful with created_at and sentiment",
          "accepted_values": "asc, desc"
        },
        {
          "name": "tweet_length_type",
          "label_zh": "推文长度类型",
          "required": false,
          "description_en": "Twitter only: tweet length type",
          "accepted_values": "short, long, thread, article"
        },
        {
          "name": "tweet_type",
          "label_zh": "推文类型",
          "required": false,
          "description_en": "Twitter only: tweet type",
          "accepted_values": "tweet, quote, reply"
        },
        {
          "name": "sentiment_type",
          "label_zh": "情绪类别",
          "required": false,
          "description_en": "Twitter only: sentiment filter. Filters on overall tweet sentiment, not sentiment about a specific token. Pair with tokens to scope.",
          "accepted_values": "bullish, bearish, neutral"
        },
        {
          "name": "author_type",
          "label_zh": "作者类别",
          "required": false,
          "description_en": "Twitter only: author type",
          "accepted_values": "Organization, Individual"
        },
        {
          "name": "min_bookmark_count",
          "label_zh": "最低收藏数",
          "required": false,
          "description_en": "Twitter only: min bookmarks"
        },
        {
          "name": "max_bookmark_count",
          "label_zh": "最高收藏数",
          "required": false,
