  "node": {
    "key": "candidates",
    "name": "候选代币筛选",
    "type": "Metric",
    "description_zh": "从五榜有效完整结果各取前N，按稳定asset_id合并去重；只确定本轮维护范围。",
    "algorithm_zh": "先校验各榜资格、时间与完整批次，再按未舍入分数降序、asset_id升序各取前N。合并稳定asset_id，同一代币跨榜只保留一次。本卡不查内容时间，不生成文案，也不保存内容。",
    "trigger_zh": "业务表成功提交、启动时与每60秒补查；合并连续通知。默认每榜前20，可逐榜改为30/50，与榜单展示条数独立。",
    "output_fields": [
      "asset_id"
    ],
    "fields": [
      {
        "name": "asset_id",
        "label_zh": "稳定内部资产ID",
        "meaning_en": "asset id",
        "data_type": "string",
        "required": true
      },
      {
        "name": "score_value",
        "label_zh": "未舍入资产得分",
        "meaning_en": "score value",
        "data_type": "number",
        "required": true
      },
      {
        "name": "calculated_at",
        "label_zh": "榜单计算时间",
        "meaning_en": "calculated at",
