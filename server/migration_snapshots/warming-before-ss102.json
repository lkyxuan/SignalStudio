{
  "leaderboard_warming": {
    "definition": "升温榜：量价门槛通过后按60分钟评分正增量排序。 保留评分明细、事件及原始依据；无真实写入时不伪造行。",
    "formula": "",
    "fields": [
      {
        "name": "object_key",
        "data_type": "string",
        "definition": "稳定资产键asset/<asset_id>；唯一身份未核实时只留观测，不发布评分"
      },
      {
        "name": "asset_id",
        "data_type": "string | null",
        "definition": "唯一核实映射的内部资产ID；账号线索或身份未定可为空"
      },
      {
        "name": "asset_name",
        "data_type": "string | null",
        "definition": "资产展示名，不作为身份匹配依据"
      },
      {
        "name": "object_kind",
        "data_type": "asset | unknown",
        "definition": "本轮只处理行情资产，账号/文本线索不进入量价榜"
      },
      {
        "name": "identity_status",
        "data_type": "resolved | source_only | conflict",
        "definition": "身份映射状态，冲突不自动合并"
      },
      {
        "name": "rank",
        "data_type": "integer | null",
        "definition": "基础结果展示序号；来源名次和综合分数分开"
      },
      {
        "name": "score",
        "data_type": "number | null",
        "definition": "本榜最终记分排序值，来自Redis量价投影；没有运行结果时为空"
      },
      {
        "name": "calculation_status",
        "data_type": "pending | calculated",
        "definition": "真实计算状态；设计交付不伪造calculated"
      },
      {
        "name": "algorithm_version",
        "data_type": "string | null",
        "definition": "实际使用的量价规则版本market_v1；无运行结果为空"
      },
      {
        "name": "reason",
        "data_type": "string | null",
        "definition": "只能描述来源数值/首次发现事实，不能虚构重要事件或原因"
      },
      {
        "name": "trend_status",
        "data_type": "warming | stable | cooling | unknown",
        "definition": "共享状态规则未定时unknown"
      },
      {
        "name": "observation_refs_json",
        "data_type": "JSON array",
        "definition": "本条关联的观测引用，包括补充行情"
      },
      {
        "name": "calculated_at",
        "data_type": "UTC timestamp | null",
        "definition": "实际结果生成时间，不能冒充来源统计截止"
      },
      {
        "name": "source_id",
        "data_type": "string",
        "definition": "来源操作ID；不同接口不可混成一个口径"
      },
      {
        "name": "source_object_id",
        "data_type": "string",
        "definition": "CoinGecko稳定coin ID，不能按symbol猜映射"
      },
      {
        "name": "snapshot_ref",
        "data_type": "string",
        "definition": "可持久回查的完整原始响应及请求参数"
      },
      {
        "name": "run_id",
        "data_type": "string",
        "definition": "采集运行标识；与统计窗口、来源记录时间分开"
      },
      {
        "name": "window_label",
        "data_type": "string | null",
        "definition": "实际请求统计窗口，例如24h；不代表采集频率"
      },
      {
        "name": "window_start",
        "data_type": "UTC timestamp | null",
        "definition": "来源明确给出的统计起点；未知不倒推"
      },
      {
        "name": "window_end",
        "data_type": "UTC timestamp | null",
        "definition": "来源明确给出的统计止点；未知不倒推"
      },
      {
        "name": "observed_at",
        "data_type": "UTC timestamp | null",
        "definition": "来源观测时间；未知不能用采集时间冒充"
      },
      {
        "name": "collected_at",
        "data_type": "UTC timestamp",
        "definition": "采集接收时间，由采集器提供"
      },
      {
        "name": "quality_status",
        "data_type": "healthy | partial | missing | unknown",
        "definition": "质量及覆盖状态；无数据不补零"
      },
      {
        "name": "coverage_key",
        "data_type": "string",
        "definition": "来源监测集合及版本"
      },
      {
        "name": "current_price",
        "data_type": "number | null",
        "definition": "CoinGecko报价币种下的当前价格"
      },
      {
        "name": "price_change_percentage_24h",
        "data_type": "number | null",
        "definition": "CoinGecko原始24h价格变化百分比，不等同关注变化"
      },
      {
        "name": "total_volume",
        "data_type": "number | null",
        "definition": "CoinGecko原始24h成交额，不称作短窗新增成交量"
      },
      {
        "name": "market_cap",
        "data_type": "number | null",
        "definition": "CoinGecko市值，用于准入和成交额/市值活跃度"
      },
      {
        "name": "quote_currency",
        "data_type": "string | null",
        "definition": "实际请求报价币种；缺失不猜USD"
      },
      {
        "name": "activity_score",
        "data_type": "number",
        "definition": "Redis中四类market_v1量价事件各自衰减后的合计"
      },
      {
        "name": "score_components_json",
        "data_type": "JSON object",
        "definition": "每项当前有效分及原始贡献依据"
      },
      {
        "name": "score_event_refs_json",
        "data_type": "JSON array",
        "definition": "参与计算的评分事件键和decision_ref"
      },
      {
        "name": "baseline_activity_score",
        "data_type": "number | null",
        "definition": "60分钟前有效已保存评分"
      },
      {
        "name": "baseline_score_at",
        "data_type": "UTC timestamp | null",
        "definition": "实际评分比较时刻"
      },
      {
        "name": "volume_ratio",
        "data_type": "number | null",
        "definition": "当前/前一天滚动24h成交额"
      },
      {
        "name": "baseline_volume_at",
        "data_type": "UTC timestamp | null",
        "definition": "行情基线时刻"
      },
      {
        "name": "price_direction",
        "data_type": "up | down | flat",
        "definition": "价格方向与评分正负分开"
      }
    ]
  },
  "生成基础升温榜": {
    "definition": "升温榜：量价门槛通过后按60分钟评分正增量排序。 保留评分明细、事件及原始依据；无真实写入时不伪造行。",
    "formula": "验证同版/覆盖的有效Polars指标与当前评分，volume_ratio≥1.5、abs_price_pct≥5；读取60分钟前已保存活动分，正增量降序。缺基线不出榜，不读取行情历史计算放量。",
