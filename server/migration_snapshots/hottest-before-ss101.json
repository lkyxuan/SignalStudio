    "approval_date": "2026-10-13",
    "implementation": "studio_design_and_pure_reference_only",
    "limitations_zh": "Studio定义与虚构演算；未启动Few采集/消费者，未创建业务存储或写真实榜单。历史覆盖、版本适配、物理绑定、真实排名质量未核验。",
    "observed_rows": [],
    "metric_version": "market_indicators_v2",
    "legacy_metric_version": "market_indicators_v1",
    "metric_compatibility": {
      "legacy_consumers": "Accept v1 and v2; project existing fields with unchanged v1 semantics, frozen identity and metric_id. RVOL adds no scoring contribution.",
      "new_hottest_consumer": "Only v2 with complete 7-day RVOL. No silent v1 fallback.",
      "upgrade_boundary": "Explicit per-message version routing before thresholds. Never rewrite old frozen v1 messages or change their IDs."
    },
    "parameters": {
      "weights": {
        "rvol_7d": 0.35,
        "volume_to_market_cap": 0.25,
        "total_volume": 0.2,
        "abs_price_pct": 0.2
      },
      "transform": "ln(1+x)",
      "mad_factor": 1.4826,
      "scale_epsilon": 1e-12,
      "clip": [
        -3,
        3
      ],
      "history_days": 7,
      "history_tolerance_minutes": 30,
      "required_history_days": 7,
      "refresh_seconds": 300,
      "max_source_age_seconds": 900,
      "result_expiry_seconds": 900,
      "top_n": 20,
      "additional_market_cap_gate": null,
      "additional_volume_gate": null,
      "class_exclusions": []
    },
    "history_rules": [
      "Same source_id/source_object_id/usd/coverage_key; history quality healthy.",
      "Per target choose requested_at≤target, target−requested_at≤30min, requested_at≤collected_at≤target, observed_at≤collected_at.",
      "Require seven distinct daily targets/observation IDs; no current/future or late data.",
      "Current volume≥0, historical volume≥0, baseline mean>0; missing history affects RVOL only.",
      "No automatic history collector/backfill; reuse the 14-day archive design; real coverage unknown."
    ],
    "batch_rules": [
      "Freeze latest observed input per asset at one cutoff before checking RVOL; no fallback to older complete metrics.",
      "Freeze cohort, coverage, parameters, normalization stats, observations and result under snapshot_id; retry identical payload or reject conflict.",
      "Identity resolved, object_kind coin, USD, finite positive price and market cap, source age≤15min; do not apply old volume/cap scoring gates.",
      "Legacy asset/token kind values need an explicit verified coin adapter, not guessing from symbol.",
      "Partial/failed/unknown coverage blocks publication; empty complete batches differ from failures.",
      "Stablecoins/wrapped assets may remain; no unapproved classification filter.",
      "Rank is cohort-relative, not a promise of news, investment value or absolute market activity."
    ],
    "metric_fields": [
